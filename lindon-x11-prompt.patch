+            if [ ! -d /usr/share/xsessions ] || ! find /usr/share/xsessions -iname '*plasma*' -print -quit 2>/dev/null | grep -q . ; then
+                apt -y install plasma-session-x11
+            fi
+            session=$(find /usr/share/xsessions \
